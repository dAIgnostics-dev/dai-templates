%% ======================================================================
%%  dAIgnostics software-documentation theme
%%  Design cues from daignostics.info: clean white canvas, geometric
%%  (Century Gothic-like) headings, single red accent, generous space.
%% ======================================================================
\usepackage{graphicx}
\usepackage{array}
\usepackage{fancyhdr}
\usepackage{lastpage}
\usepackage[explicit]{titlesec}
\usepackage{enumitem}
\usepackage{tcolorbox}
\tcbuselibrary{skins,breakable}

%% ---- Brand palette -----------------------------------------------------
\definecolor{dgred}{HTML}{E21E3A}   % dAIgnostics accent (logo red)
\definecolor{dgink}{HTML}{303030}   % near-black (logo ink; headings/text)
\definecolor{dgslate}{HTML}{2B3A4A} % secondary dark
\definecolor{dgmuted}{HTML}{5A6B7B} % muted captions / running heads
\definecolor{dgline}{HTML}{D7DEE4}  % hairlines
\definecolor{dgbg}{HTML}{F4F6F8}    % code / callout fill
\definecolor{dgeu}{HTML}{003399}    % EU blue (for the funding note)

%% ---- Page geometry (only if the user did not supply their own) --------
$if(geometry)$
$else$
\usepackage[a4paper,top=2.6cm,bottom=2.7cm,left=2.4cm,right=2.4cm,%
            headheight=16pt,headsep=16pt,footskip=1.15cm]{geometry}
$endif$

%% ---- Body colour & links ----------------------------------------------
\color{dgink}
\hypersetup{colorlinks=true,linkcolor=dgslate,urlcolor=dgred,%
            citecolor=dgred,filecolor=dgred}

%% ---- EU funding logo (shown on every page) ----------------------------
\newcommand{\dgEUlogo}{$if(eu-logo)$$eu-logo$$else$eu-logo.png$endif$}
\newcommand{\dgEUlogobox}{%
  \IfFileExists{\dgEUlogo}%
    {\raisebox{-0.52cm}[0pt][0pt]{\includegraphics[height=1.25cm]{\dgEUlogo}}}%
    {}}

%% ---- Brand logo (registered figurative mark HR Z20251009) -------------
% daignostics-logo.pdf is used exactly as supplied by Marketing: never
% redrawn, stretched or recoloured (only scaled by height, aspect kept).
% It is lowered by 15.5 % of its height (measured) so the lettering, not
% the descender of the "g", sits on the text baseline.
% build.sh puts the template folder on TEXINPUTS so it is found from any
% working directory. If the file is missing, the text wordmark is used.
\newcommand{\dglogofile}{daignostics-logo.pdf}
\newcommand{\dgtextwordmark}{{\dgheadingfont\bfseries\large d\textcolor{dgred}{AI}gnostics}}
\newcommand{\dglogo}[1]{% #1 = logo height
  \IfFileExists{\dglogofile}%
    {\raisebox{-0.155\height}{\includegraphics[height=#1]{\dglogofile}}}%
    {\dgtextwordmark}}

%% ---- Header / footer brandmark ----------------------------------------
\newcommand{\dgwordmark}{\dglogo{4.5mm}}
\newcommand{\dgheaderleft}{$if(header-left)$$header-left$$else$\dgwordmark$endif$}
\newcommand{\dgfooterleft}{$if(confidential)$\textcolor{dgred}{\footnotesize\scshape Confidential}$else$$if(project)$\textcolor{dgmuted}{\footnotesize $project$}$else$$endif$$endif$}

\setlength{\headheight}{16pt}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.8pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{dgred}%
  \leaders\hrule height \headrulewidth\hfill}}
\fancyhead[L]{\dgheaderleft}
\fancyhead[R]{\footnotesize\itshape\textcolor{dgmuted}{$if(title-meta)$$title-meta$$endif$}}
\fancyfoot[L]{\dgfooterleft}
\fancyfoot[C]{\footnotesize\textcolor{dgmuted}{\thepage\ / \pageref{LastPage}}}
\fancyfoot[R]{\dgEUlogobox}
% Pages that LaTeX forces to "plain" (title, section starts) keep the logo:
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
  \fancyfoot[L]{\dgfooterleft}%
  \fancyfoot[C]{\footnotesize\textcolor{dgmuted}{\thepage\ / \pageref{LastPage}}}%
  \fancyfoot[R]{\dgEUlogobox}%
}

%% ---- Headings (geometric, slate, red number + hairline on sections) ---
\titleformat{\section}[hang]
  {\dgheadingfont\bfseries\LARGE\color{dgink}}
  {\color{dgred}\thesection\hspace{0.6em}}{0pt}{#1}
  [\vspace{2pt}{\color{dgline}\titlerule[0.8pt]}]
\titleformat{\subsection}[hang]
  {\dgheadingfont\bfseries\Large\color{dgink}}
  {\color{dgred}\thesubsection\hspace{0.5em}}{0pt}{#1}
\titleformat{\subsubsection}[hang]
  {\dgheadingfont\bfseries\large\color{dgslate}}
  {\color{dgred}\thesubsubsection\hspace{0.5em}}{0pt}{#1}
\titleformat{\paragraph}[runin]
  {\dgheadingfont\bfseries\normalsize\color{dgslate}}{}{0pt}{#1}
\titlespacing*{\section}{0pt}{1.7em plus .3em minus .2em}{0.8em}
\titlespacing*{\subsection}{0pt}{1.3em plus .2em minus .2em}{0.5em}
\titlespacing*{\subsubsection}{0pt}{1.0em plus .2em minus .2em}{0.4em}

%% ---- Page-break hygiene ------------------------------------------------
% Keep headings and table starts off the bottom of a page: demand some free
% space before them, otherwise break first. Patched \AtBeginDocument, after
% titlesec and any header-includes are done (re)defining \section & co.,
% so they cannot overwrite the patch.
\usepackage{needspace}
\usepackage{etoolbox}
\AtBeginDocument{%
  \preto\section{\Needspace*{0.26\textheight}}%
  \preto\subsection{\Needspace*{0.13\textheight}}%
  \preto\subsubsection{\Needspace*{0.12\textheight}}% 0.09 left a heading + table split
}
% Tables: same idea, except directly after a heading. There the heading's
% \Needspace has already reserved room, and a forced break (or longtable's
% own \penalty0 before \LTpre) would leave the heading alone at the bottom.
% (\LT@start is expl3 code in longtable >= 2024, plain LaTeX before: the
% patch is tried under both catcode regimes; if neither matches, only the
% \Needspace part applies.)
\makeatletter
\def\dgLTpenalty{\penalty\z@}
\ifdefined\LT@start
  \patchcmd\LT@start{\endgraf\penalty\z@\vskip\LTpre}%
    {\endgraf\dgLTpenalty\vskip\LTpre}{}{%
    \ExplSyntaxOn
    \patchcmd\LT@start{\endgraf\penalty\z@\vskip\LTpre}%
      {\endgraf\dgLTpenalty\vskip\LTpre}{}{}%
    \ExplSyntaxOff}
\fi
\AtBeginDocument{\ifdef{\longtable}{%
  \AtBeginEnvironment{longtable}{%
    \if@nobreak\def\dgLTpenalty{\nobreak}%
    \else\Needspace*{0.11\textheight}\fi}}{}}
\makeatother
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000

%% ---- Code blocks -------------------------------------------------------
% pandoc's highlighted code lives in the Shaded environment; restyle it as
% a soft grey card with a red spine. (Guarded: only if code is present.)
\ifdefined\Shaded
\renewenvironment{Shaded}{%
  \begin{tcolorbox}[breakable,enhanced jigsaw,boxrule=0pt,frame hidden,
    colback=dgbg,sharp corners,left=9pt,right=9pt,top=7pt,bottom=7pt,
    borderline west={2.5pt}{0pt}{dgred},
    before skip=9pt,after skip=9pt]\footnotesize}%
  {\end{tcolorbox}}
\fi

%% ---- Callout / admonition boxes (used by admonitions.lua) -------------
\newtcolorbox{dgnote}[1][Note]{breakable,enhanced jigsaw,boxrule=0pt,
  frame hidden,colback=dgbg,sharp corners,left=10pt,right=10pt,top=8pt,
  bottom=8pt,borderline west={3pt}{0pt}{dgslate},
  fonttitle=\dgheadingfont\bfseries\color{dgslate},title={#1}}
\newtcolorbox{dgtip}[1][Tip]{breakable,enhanced jigsaw,boxrule=0pt,
  frame hidden,colback=dgbg,sharp corners,left=10pt,right=10pt,top=8pt,
  bottom=8pt,borderline west={3pt}{0pt}{dgeu},
  fonttitle=\dgheadingfont\bfseries\color{dgeu},title={#1}}
\newtcolorbox{dgwarning}[1][Warning]{breakable,enhanced jigsaw,boxrule=0pt,
  frame hidden,colback=dgbg,sharp corners,left=10pt,right=10pt,top=8pt,
  bottom=8pt,borderline west={3pt}{0pt}{dgred},
  fonttitle=\dgheadingfont\bfseries\color{dgred},title={#1}}
\let\dgimportant\dgwarning \let\enddgimportant\enddgwarning

%% ---- Cover-page helpers ------------------------------------------------
\newcommand{\dgaccentbar}{\noindent{\color{dgred}\rule{\linewidth}{3pt}}}

\begin{document}
$if(has-frontmatter)$
\frontmatter
$endif$
$if(title)$
$if(beamer)$
\frame{\titlepage}
$else$
%% ===== dAIgnostics cover page =====
\begin{titlepage}
\thispagestyle{empty}
\dgheadingfont
\vspace*{0.4cm}
\noindent{\dglogo{8mm}}\hfill$if(project)$\textcolor{dgmuted}{\normalsize $project$}$endif$\par
\vspace{0.3cm}
\dgaccentbar
\vfill
\noindent$if(doctype)$\textcolor{dgred}{\bfseries\large\MakeUppercase{$doctype$}}\par\vspace{0.5cm}$else$\textcolor{dgred}{\bfseries\large\MakeUppercase{Software Documentation}}\par\vspace{0.5cm}$endif$
\noindent{\bfseries\fontsize{34}{40}\selectfont\color{dgink}$title$\par}
$if(subtitle)$\vspace{0.45cm}\noindent{\Large\color{dgmuted}$subtitle$\par}$endif$
\vspace{0.7cm}
\noindent{\color{dgline}\rule{6cm}{1.2pt}}\par
\vspace{0.7cm}
\noindent\begin{tabular}{@{}>{\bfseries\color{dgslate}}l@{\hspace{1.2em}}l@{}}
$if(author)$Author(s) & \color{dgink}$for(author)$$author$$sep$, $endfor$ \\[3pt]$endif$
$if(version)$Version & \color{dgink}$version$ \\[3pt]$endif$
$if(date)$Date & \color{dgink}$date$ \\[3pt]$endif$
\end{tabular}
\vfill
%% Funding acknowledgement + EU emblem (cover instance)
\noindent\begin{minipage}[c]{0.66\linewidth}
  \rmfamily\footnotesize\color{dgmuted}
  $if(funding)$$funding$$else$This project has received funding from the European Union. Views and opinions expressed are however those of the author(s) only and do not necessarily reflect those of the European Union.$endif$
\end{minipage}\hfill
\begin{minipage}[c]{0.30\linewidth}\raggedleft
  \IfFileExists{\dgEUlogo}{\includegraphics[height=2.4cm]{\dgEUlogo}}{}
\end{minipage}
\end{titlepage}
$endif$
$if(abstract)$
\begin{abstract}
$abstract$
\end{abstract}
$endif$
$endif$

$for(include-before)$
$include-before$

$endfor$
$if(toc)$
$if(toc-title)$
\renewcommand*\contentsname{$toc-title$}
$endif$
$if(beamer)$
\begin{frame}[allowframebreaks]
$if(toc-title)$
  \frametitle{$toc-title$}
$endif$
  \tableofcontents[hideallsubsections]
\end{frame}
$else$
{
$if(colorlinks)$
\hypersetup{linkcolor=$if(toccolor)$$toccolor$$else$$endif$}
$endif$
\setcounter{tocdepth}{$toc-depth$}
\tableofcontents
}
$endif$
$endif$
$if(lof)$
\listoffigures
$endif$
$if(lot)$
\listoftables
$endif$
$if(linestretch)$
\setstretch{$linestretch$}
$endif$
$if(has-frontmatter)$
\mainmatter
$endif$
$body$

$if(has-frontmatter)$
\backmatter
$endif$
$if(natbib)$
$if(bibliography)$
$if(biblio-title)$
$if(has-chapters)$
\renewcommand\bibname{$biblio-title$}
$else$
\renewcommand\refname{$biblio-title$}
$endif$
$endif$
$if(beamer)$
\begin{frame}[allowframebreaks]{$biblio-title$}
  \bibliographytrue
$endif$
  \bibliography{$for(bibliography)$$bibliography$$sep$,$endfor$}
$if(beamer)$
\end{frame}
$endif$

$endif$
$endif$
$if(biblatex)$
$if(beamer)$
\begin{frame}[allowframebreaks]{$biblio-title$}
  \bibliographytrue
  \printbibliography[heading=none]
\end{frame}
$else$
\printbibliography$if(biblio-title)$[title=$biblio-title$]$endif$
$endif$

$endif$
$for(include-after)$
$include-after$

$endfor$
\end{document}
