%% =====================================================================
%%  dAIgnostics business letter (dopis) -- pandoc -> PDF (XeLaTeX)
%%  Layout: A4, DIN 5008 form B (window envelope DL / C5/6, right or left
%%  window at 20/25 mm from the left edge, 45 mm from the top), legal data
%%  required by ZTD art. 21(4)-(5) in the footer of every page.
%%  Style: brand colours (Marketing, 2026-11-22) #303030 / #E21E3A, official
%%  vector logo, slogan; fonts as ../pandoc-document (Heros + Adventor).
%%  Use only through build.sh (needs letter.lua and company.yaml).
%% =====================================================================
\documentclass[11pt]{article}

%% ---- Fonts -------------------------------------------------------------
\usepackage{fontspec}
\defaultfontfeatures{Ligatures=TeX}
%% Same fonts as ../pandoc-document (Sandi): TeX Gyre Heros (~Helvetica/Arial)
%% for text, TeX Gyre Adventor (~Century Gothic) for headings.
\setmainfont{TeX Gyre Heros}[Scale = 0.92]
\setsansfont{TeX Gyre Heros}[Scale = 0.92]
\setmonofont{DejaVu Sans Mono}[Scale = 0.82]
\newfontfamily\dgheadingfont{TeX Gyre Adventor}

\usepackage{polyglossia}
$if(lang-en)$
\setdefaultlanguage[variant=british]{english}
\setotherlanguage{croatian}
$else$
\setdefaultlanguage{croatian}
\setotherlanguage[variant=british]{english}
$endif$

%% ---- Page geometry -----------------------------------------------------
%% Pages 2+ start at top=27 mm; page 1 is pushed down to the DIN subject
%% line by \dgfirstpageskip below.
\usepackage[a4paper,left=25mm,right=20mm,top=27mm,bottom=34mm,%
            headheight=14pt,headsep=8mm,footskip=17mm]{geometry}

%% ---- Packages ----------------------------------------------------------
\usepackage{xcolor}
\usepackage{graphicx}
\usepackage{array,longtable,booktabs,calc}
\usepackage{fancyhdr}
\usepackage{lastpage}
\usepackage{refcount}
\usepackage{tikz}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{microtype}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.75\baselineskip}
\linespread{1.08}
\setlist{itemsep=0.15em,topsep=0.2em,leftmargin=1.4em}
\setlist[itemize]{label={\color{dgred}\textbullet}}
\raggedbottom
\widowpenalty=10000
\clubpenalty=10000

\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{%
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox{\pandoc@box}\fi}
\makeatother
\def\LTcaptype{none}

%% ---- Palette: brand allows only dark grey and red for text ------------
\definecolor{dgred}{HTML}{E21E3A}
\definecolor{dgink}{HTML}{303030}
\definecolor{dgslate}{HTML}{303030}
\definecolor{dgmuted}{HTML}{303030}
\definecolor{dgline}{HTML}{D9D9D9}   % hairlines only, never text
\color{dgink}

%% Official logo (vector, from Marketing: Visuals/daignostics-vector.svg)
\newcommand{\dglogofile}{$if(logo)$$logo$$else$daignostics-logo.pdf$endif$}
\newcommand{\dgwordmark}[1][4.2mm]{\IfFileExists{\dglogofile}%
  {\includegraphics[height=#1]{\dglogofile}}%
  {{\bfseries d\textcolor{dgred}{AI}gnostics}}}
\newcommand{\dgslogan}{{\bfseries Detect earlier. \textcolor{dgred}{Act smarter.} For a life worth living.}}
\newcommand{\dgEUlogo}{$if(eu-logo)$$eu-logo$$else$eu-logo.png$endif$}

%% ---- Legal footer (ZTD art. 21) ----------------------------------------
\newcommand{\dglegal}{%
  \fontsize{6.6}{8.4}\selectfont\color{dgmuted}%
  \begin{minipage}[t]{0.29\linewidth}\raggedright
    {\color{dgslate}\bfseries $company-name$}\\
    $company-street$, $company-city$$if(lang-en)$, $company-country-en$$endif$\\
    $company-web$ · $company-email$\\
    $company-phone$
  \end{minipage}\hfill
  \begin{minipage}[t]{0.31\linewidth}\raggedright
    $label-court$: $if(lang-en)$$company-court-en$$else$$company-court$$endif$\\
    $label-mbs$: $company-mbs$ · $label-oib$: $if(lang-en)$$company-vat$$else$$company-oib$$endif$\\
    $label-capital$: $if(lang-en)$$company-capital-en$$else$$company-capital$$endif$$if(lang-en)$$if(company-capital-paid-en)$, $company-capital-paid-en$$endif$$else$$if(company-capital-paid)$, $company-capital-paid$$endif$$endif$\\
    $label-management$: $company-management$
  \end{minipage}\hfill
  \begin{minipage}[t]{$if(eu-funding)$0.27\linewidth$else$0.33\linewidth$endif$}\raggedright
    $label-bank$: $company-bank$\\
    IBAN: $company-iban$\\
    SWIFT/BIC: $company-swift$
  \end{minipage}%
  $if(eu-funding)$\hfill
  \begin{minipage}[t]{0.09\linewidth}\raggedleft
    \IfFileExists{\dgEUlogo}{\raisebox{-0.75\height}{\includegraphics[height=0.95cm]{\dgEUlogo}}}{}
  \end{minipage}$endif$}

\newcommand{\dgpageno}{%
  \ifnum\getpagerefnumber{LastPage}>1
    $label-page$ \thepage\ / \pageref{LastPage}%
  \fi}

%% ---- Page styles -------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{dgred}%
  \leaders\hrule height \headrulewidth\hfill}}
\fancyhead[L]{\raisebox{-0.5mm}{\dgwordmark[4.2mm]}}
\fancyhead[R]{\footnotesize\color{dgmuted}$if(our-ref)$$our-ref$\quad·\quad$endif$\dgpageno}
\fancyfoot[C]{\color{dgline}\rule{\linewidth}{0.4pt}\\[2pt]\dglegal}
\fancypagestyle{dgfirst}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\color{dgline}\rule{\linewidth}{0.4pt}\\[2pt]\dglegal}}

\begin{document}
\thispagestyle{dgfirst}

%% ---- Page 1: letterhead, address window, reference block, marks ------
\begin{tikzpicture}[remember picture,overlay,x=1mm,y=1mm]
  \coordinate (O) at (current page.north west);
$if(layout-b)$
  %% ---- Variant B: centred, minimal -------------------------------------
  \node[anchor=north,inner sep=0] at ([shift={(107.5,-12)}]O) {\dgwordmark[12mm]};
  \node[anchor=base,inner sep=0,font=\fontsize{7.6}{9}\selectfont,text=dgink]
    at ([shift={(107.5,-29)}]O) {\dgslogan};
  \draw[dgred,line width=1pt] ([shift={(95,-32)}]O) -- ([shift={(120,-32)}]O);
  \node[anchor=base,inner sep=0,font=\fontsize{7.2}{9}\selectfont,text=dgink]
    at ([shift={(107.5,-37)}]O)
    {$company-street$, $company-city$$if(lang-en)$, $company-country-en$$endif$\quad
     \textbf{T:} $company-phone$\quad \textbf{E:} $company-email$\quad \textbf{W:} www.$company-web$};
$elseif(layout-c)$
  %% ---- Variant C: logo | red vertical line | contact ------------------
  \node[anchor=north west,inner sep=0] at ([shift={(25,-14)}]O) {\dgwordmark[10mm]};
  \node[anchor=base west,inner sep=0,font=\fontsize{7.6}{9}\selectfont,text=dgink]
    at ([shift={(25,-29)}]O) {\dgslogan};
  \draw[dgred,line width=1.4pt] ([shift={(132,-13)}]O) -- ([shift={(132,-30)}]O);
  \node[anchor=north west,inner sep=0,align=left,
        font=\fontsize{7.6}{10}\selectfont,text=dgink]
    at ([shift={(136,-13.4)}]O)
    {$company-street$, $company-city$$if(lang-en)$, $company-country-en$$endif$\\
     \textbf{T:} $company-phone$\\ \textbf{E:} $company-email$\\ \textbf{W:} www.$company-web$};
$else$
  %% ---- Variant A: logo left, contact right, red rule ------------------
  \node[anchor=north west,inner sep=0] at ([shift={(25,-13)}]O)
    {\dgwordmark[11mm]};
  \node[anchor=base west,inner sep=0,font=\fontsize{7.6}{9}\selectfont,text=dgink]
    at ([shift={(25,-28.6)}]O) {\dgslogan};
  \node[anchor=north east,inner sep=0,align=right,
        font=\fontsize{7.6}{10}\selectfont,text=dgink]
    at ([shift={(190,-13)}]O)
    {$company-street$, $company-city$$if(lang-en)$, $company-country-en$$endif$\\
     \textbf{T:} $company-phone$\\ \textbf{E:} $company-email$\\ \textbf{W:} www.$company-web$};
  \draw[dgred,line width=0.8pt] ([shift={(25,-31)}]O) -- ([shift={(190,-31)}]O);
$endif$
  % return address (DIN 5008 additional zone, above the recipient)
  \node[anchor=base west,inner sep=0,font=\fontsize{6.6}{8}\selectfont,text=dgmuted]
    at ([shift={(25,-59.5)}]O)
    {$company-short$ · $company-street$ · $company-city$$if(lang-en)$ · $company-country-en$$endif$};
  \draw[dgline,line width=0.3pt] ([shift={(25,-61)}]O) -- ([shift={(105,-61)}]O);
  % recipient (address field 62.7-90 mm)
  \node[anchor=north west,inner sep=0,align=left,
        font=\fontsize{10.5}{13}\selectfont,text=dgink]
    at ([shift={(25,-64.5)}]O)
    {$for(recipient)$$recipient$$sep$\\ $endfor$};
  % reference block (DIN 5008 information block, x = 125 mm)
  \node[anchor=north west,inner sep=0] at ([shift={(120,-50)}]O) {%
    \fontsize{8}{10.2}\selectfont\color{dgink}
    \begin{tabular}{@{}l@{\hspace{3mm}}>{\raggedright\arraybackslash}p{46mm}@{}}
    $if(our-ref)$\textcolor{dgmuted}{$label-our-ref$} & \textenglish{\hyphenchar\font=-1 $our-ref$} \\[2pt]$endif$
    $if(your-ref)$\textcolor{dgmuted}{$label-your-ref$} & $your-ref$ \\[2pt]$endif$
    $if(date)$\textcolor{dgmuted}{$label-date$} & $if(place)$$place$, $endif$$date$ \\[2pt]$endif$
    $if(contact)$\textcolor{dgmuted}{$label-contact$} & $contact$$if(contact-email)$\newline $contact-email$$endif$$if(contact-phone)$\newline $contact-phone$$endif$ \\$endif$
    \end{tabular}};
  % fold marks (105 / 210 mm) and punch mark (148.5 mm)
  \draw[dgline,line width=0.4pt] ([shift={(4,-105)}]O) -- ([shift={(9,-105)}]O);
  \draw[dgline,line width=0.4pt] ([shift={(4,-210)}]O) -- ([shift={(9,-210)}]O);
  \draw[dgline,line width=0.4pt] ([shift={(4,-148.5)}]O) -- ([shift={(11,-148.5)}]O);
  $if(eu-funding)$
  % funding acknowledgement, page 1 only, above the footer
  \node[anchor=south west,inner sep=0,font=\fontsize{6.6}{8}\selectfont,text=dgmuted]
    at ([shift={(25,22.2)}]current page.south west) {$funding$};
  $endif$
\end{tikzpicture}%
%% push the subject down to the DIN 5008 position (~103 mm from the top)
\vspace*{\dimexpr 103mm - 27mm - \baselineskip\relax}

$if(subject)$
{\dgheadingfont\bfseries\large $label-subject$: $subject$\par}
\vspace{0.4\baselineskip}
$endif$

$if(opening)$
$opening$

$endif$
$body$

\par\vspace{0.6\baselineskip}
\noindent\begin{minipage}{\linewidth}
\setlength{\parskip}{0pt}
$closing$\par
$if(signature)$
\vspace{1mm}\includegraphics[height=16mm]{$signature$}\par\vspace{1mm}
$else$
\vspace{18mm}
$endif$
$if(signatory)${\bfseries $signatory$}\par$endif$
$if(signatory-title)${\bfseries\color{dgred}$signatory-title$}\par$endif$
$company-short$\par
\end{minipage}

$if(enclosures)$
\par\vspace{0.4\baselineskip}
\noindent\begin{minipage}{\linewidth}\small
{\bfseries $label-enclosures$:}
\begin{itemize}[label={–},leftmargin=1.2em,itemsep=0pt,topsep=1pt]
$for(enclosures)$
\item $enclosures$
$endfor$
\end{itemize}
\end{minipage}
$endif$
$if(cc)$
\par\vspace{0.4\baselineskip}
\noindent\begin{minipage}{\linewidth}\small
{\bfseries $label-cc$:}
\begin{itemize}[label={–},leftmargin=1.2em,itemsep=0pt,topsep=1pt]
$for(cc)$
\item $cc$
$endfor$
\end{itemize}
\end{minipage}
$endif$
\end{document}
